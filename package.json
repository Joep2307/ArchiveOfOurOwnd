{
    "name": "ao3-history-stats",
    "version": "0.1.0",
    "private": true,
    "description": "Reading statistics for your AO3 history (unofficial).",
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "dev": "tsx scripts/build.ts --watch",
        "build": "pnpm build:wasm && pnpm build:ext",
        "build:ext": "tsx scripts/build.ts",
        "build:wasm": "wasm-pack build crates/stats-core --target web --release --no-pack --out-dir ../../src/wasm/stats-core",
        "preview": "tsx scripts/preview.ts",
        "zip": "tsx scripts/zip.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && stylelint \"src/**/*.scss\"",
        "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:smoke": "vitest run tests/smoke.test.ts",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm lint-staged && pnpm test:smoke",
        "pre-push": "pnpm typecheck"
    },
    "lint-staged": {
        "*.ts": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.scss": [
            "prettier --write",
            "stylelint --fix"
        ],
        "*.{json,md,yml,html}": "prettier --write"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chrome": "^0.3.0",
        "@types/node": "^22.20.3",
        "@vitest/coverage-v8": "^5.0.1",
        "eslint": "^10.10.0",
        "fflate": "^0.8.3",
        "jiti": "^2.7.0",
        "jsdom": "^30.0.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.7",
        "sass-embedded": "^1.104.1",
        "simple-git-hooks": "^2.14.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
